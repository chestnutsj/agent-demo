{
  "name": "opt-agent",
  "version": "0.1.0",
  "description": "DSH plugins: a MySQL MCP tool bundle and a SQL-optimization subagent bundle.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
